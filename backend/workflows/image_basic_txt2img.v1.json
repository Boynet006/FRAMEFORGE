{
  "name": "image_basic_txt2img",
  "version": 1,
  "engine": "comfyui",
  "description": "Single image from a text prompt with any SD1.5/SDXL checkpoint (ComfyUI default graph). Used as the first real-engine smoke test.",
  "output_kind": "image",
  "validated": false,
  "requires": {
    "models": ["any checkpoint in ComfyUI/models/checkpoints"]
  },
  "inputs": {
    "prompt":          {"node": "6", "field": "text",        "type": "string",  "default": "a cinematic portrait of a cat, studio lighting", "label": "Prompt"},
    "negative_prompt": {"node": "7", "field": "text",        "type": "string",  "default": "blurry, low quality, watermark, text", "label": "Negative prompt"},
    "checkpoint":      {"node": "4", "field": "ckpt_name",   "type": "string",  "default": "sd_xl_base_1.0.safetensors", "label": "Checkpoint file"},
    "width":           {"node": "5", "field": "width",       "type": "integer", "default": 1024, "min": 256, "max": 2048, "step": 8, "label": "Width"},
    "height":          {"node": "5", "field": "height",      "type": "integer", "default": 1024, "min": 256, "max": 2048, "step": 8, "label": "Height"},
    "steps":           {"node": "3", "field": "steps",       "type": "integer", "default": 20, "min": 1, "max": 100, "label": "Steps"},
    "cfg":             {"node": "3", "field": "cfg",         "type": "number",  "default": 7.0, "min": 0, "max": 30, "label": "CFG"},
    "seed":            {"node": "3", "field": "seed",        "type": "integer", "default": -1, "label": "Seed (-1 = random)"}
  },
  "outputs": [{"node": "9", "kind": "image"}],
  "graph": {
    "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
    "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 20, "cfg": 7.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "FRAMEFORGE/image", "images": ["8", 0]}}
  }
}
