{
  "name": "image_sd15_lcm",
  "version": 1,
  "engine": "comfyui",
  "description": "Fast image with Stable Diffusion 1.5 + LCM LoRA (6 steps, CFG 1.5). The CPU-mode reference-image generator; also fine on any GPU. Validated on ComfyUI 0.41 CPU: 512x640 in ~70 s after model load on a 20-core CPU.",
  "output_kind": "image",
  "validated": true,
  "requires": {
    "models": [
      "checkpoints/v1-5-pruned-emaonly-fp16.safetensors",
      "loras/lcm-lora-sdv1-5.safetensors"
    ]
  },
  "inputs": {
    "prompt":          {"node": "6",  "field": "text",      "type": "string",  "default": "portrait of a cat, soft light", "label": "Prompt"},
    "negative_prompt": {"node": "7",  "field": "text",      "type": "string",  "default": "blurry, low quality, watermark, text, deformed", "label": "Negative prompt"},
    "checkpoint":      {"node": "4",  "field": "ckpt_name", "type": "string",  "default": "v1-5-pruned-emaonly-fp16.safetensors", "label": "Checkpoint file"},
    "lora":            {"node": "10", "field": "lora_name", "type": "string",  "default": "lcm-lora-sdv1-5.safetensors", "label": "LCM LoRA file"},
    "width":           {"node": "5",  "field": "width",     "type": "integer", "default": 512, "min": 256, "max": 1024, "step": 8, "label": "Width"},
    "height":          {"node": "5",  "field": "height",    "type": "integer", "default": 512, "min": 256, "max": 1024, "step": 8, "label": "Height"},
    "steps":           {"node": "3",  "field": "steps",     "type": "integer", "default": 6, "min": 2, "max": 12, "label": "Steps"},
    "cfg":             {"node": "3",  "field": "cfg",       "type": "number",  "default": 1.5, "min": 1, "max": 3, "label": "CFG"},
    "seed":            {"node": "3",  "field": "seed",      "type": "integer", "default": -1, "label": "Seed (-1 = random)"}
  },
  "outputs": [{"node": "9", "kind": "image"}],
  "graph": {
    "4":  {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors"}},
    "10": {"class_type": "LoraLoader", "inputs": {"lora_name": "lcm-lora-sdv1-5.safetensors", "strength_model": 1.0, "strength_clip": 1.0, "model": ["4", 0], "clip": ["4", 1]}},
    "5":  {"class_type": "EmptyLatentImage", "inputs": {"width": 512, "height": 512, "batch_size": 1}},
    "6":  {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["10", 1]}},
    "7":  {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["10", 1]}},
    "3":  {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 6, "cfg": 1.5, "sampler_name": "lcm", "scheduler": "sgm_uniform", "denoise": 1.0, "model": ["10", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
    "8":  {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
    "9":  {"class_type": "SaveImage", "inputs": {"filename_prefix": "FRAMEFORGE/ref", "images": ["8", 0]}}
  }
}
