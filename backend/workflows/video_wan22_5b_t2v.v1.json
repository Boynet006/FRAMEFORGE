{
  "name": "video_wan22_5b_t2v",
  "version": 1,
  "engine": "comfyui",
  "description": "Short text-to-video clip with Wan 2.2 TI2V 5B (fp16), the draft-quality engine. Mirrors the ComfyUI native Wan 2.2 5B template. NOT yet validated on real hardware.",
  "output_kind": "video",
  "validated": false,
  "requires": {
    "models": [
      "diffusion_models/wan2.2_ti2v_5B_fp16.safetensors",
      "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "vae/wan2.2_vae.safetensors"
    ]
  },
  "inputs": {
    "prompt":          {"node": "6",  "field": "text",   "type": "string",  "default": "a fluffy orange cat sitting at a kitchen table, cinematic lighting, slow camera push-in", "label": "Prompt"},
    "negative_prompt": {"node": "7",  "field": "text",   "type": "string",  "default": "blurry, distorted, low quality, text, watermark, static, extra limbs", "label": "Negative prompt"},
    "width":           {"node": "55", "field": "width",  "type": "integer", "default": 1280, "min": 256, "max": 1920, "step": 16, "label": "Width"},
    "height":          {"node": "55", "field": "height", "type": "integer", "default": 704,  "min": 256, "max": 1920, "step": 16, "label": "Height"},
    "frames":          {"node": "55", "field": "length", "type": "integer", "default": 121,  "min": 5,   "max": 241,  "step": 4,  "label": "Frames (4n+1)"},
    "steps":           {"node": "3",  "field": "steps",  "type": "integer", "default": 30,   "min": 1,   "max": 60, "label": "Steps"},
    "cfg":             {"node": "3",  "field": "cfg",    "type": "number",  "default": 5.0,  "min": 0,   "max": 20, "label": "CFG"},
    "seed":            {"node": "3",  "field": "seed",   "type": "integer", "default": -1, "label": "Seed (-1 = random)"},
    "fps":             {"node": "57", "field": "fps",    "type": "integer", "default": 24,   "min": 8,   "max": 60, "label": "FPS"}
  },
  "outputs": [{"node": "58", "kind": "video"}],
  "graph": {
    "37": {"class_type": "UNETLoader", "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}},
    "38": {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
    "39": {"class_type": "VAELoader", "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
    "6":  {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["38", 0]}},
    "7":  {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["38", 0]}},
    "48": {"class_type": "ModelSamplingSD3", "inputs": {"shift": 8.0, "model": ["37", 0]}},
    "55": {"class_type": "Wan22ImageToVideoLatent", "inputs": {"width": 1280, "height": 704, "length": 121, "batch_size": 1, "vae": ["39", 0]}},
    "3":  {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0, "model": ["48", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["55", 0]}},
    "8":  {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["39", 0]}},
    "57": {"class_type": "CreateVideo", "inputs": {"fps": 24, "images": ["8", 0]}},
    "58": {"class_type": "SaveVideo", "inputs": {"filename_prefix": "FRAMEFORGE/video", "format": "auto", "codec": "auto", "video": ["57", 0]}}
  }
}
