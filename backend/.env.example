# Copy to .env and adjust. Never commit .env.

# Where the FastAPI server listens
FRAMEFORGE_HOST=127.0.0.1
FRAMEFORGE_PORT=8000

# ComfyUI HTTP API base URL (ComfyUI default is 8188)
FRAMEFORGE_COMFYUI_URL=http://127.0.0.1:8188
FRAMEFORGE_COMFYUI_TIMEOUT_S=3
# Fallback history polling interval when the ComfyUI websocket is unavailable
FRAMEFORGE_COMFYUI_POLL_S=2
# Hard ceiling for a single generation job, seconds
FRAMEFORGE_JOB_TIMEOUT_S=21600
# Automatic retries when ComfyUI is unreachable mid-job
FRAMEFORGE_JOB_MAX_ATTEMPTS=3

# Ollama API base URL and the model used for script/plan generation
FRAMEFORGE_OLLAMA_URL=http://127.0.0.1:11434
# CPU-only dev machine: qwen3:4b. RTX 5080: qwen3:14b
FRAMEFORGE_OLLAMA_MODEL=qwen3:4b
FRAMEFORGE_OLLAMA_TIMEOUT_S=900

# Workflow template for character/environment reference images (see backend/workflows)
FRAMEFORGE_IMAGE_WORKFLOW=image_sd15_lcm

# Text-to-speech: "kokoro" needs backend/.venv-tts (see README); "fake" produces placeholder audio
FRAMEFORGE_TTS_ENGINE=kokoro
FRAMEFORGE_TTS_PYTHON=./.venv-tts/Scripts/python.exe
FRAMEFORGE_TTS_LANG=a

# SQLite database file (relative paths resolve against the backend/ folder)
FRAMEFORGE_DATABASE_URL=sqlite:///./data/frameforge.db

# Folder for project outputs (relative to backend/ unless absolute)
FRAMEFORGE_DATA_DIR=./data

# Frontend origin allowed by CORS (comma-separated for several)
FRAMEFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DEBUG | INFO | WARNING | ERROR
FRAMEFORGE_LOG_LEVEL=INFO
